#!/usr/bin/env bash
set -euo pipefail
if kdialog --title 'Synterra Indev (Prism 0.5)' --yesno 'Welcome to Synterra Indev (Prism 0.5).\n\nA new Synterra GRUB splash welcomes you at boot. Choose GRUB in the installer to keep the themed boot screen. Synterra Surf includes private windows, find-in-page, history and downloads. Open PDFs in Okular, play media in VLC and explore disk usage with Filelight. Spectacle and Gwenview are also included. Aurora and Graphite are available in Desktop and Wallpaper settings.\n\nThe guided installer applies this desktop to your installed system. Connect to the internet first. At the final Archinstall screen choose EXIT so Synterra can finish.\n\nStart the installer now?' --yes-label 'Install Synterra' --no-label 'Explore desktop'; then
    exec synterra-install
fi
