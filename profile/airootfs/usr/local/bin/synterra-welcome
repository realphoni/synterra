#!/usr/bin/env bash
set -euo pipefail
if kdialog --title 'Synterra Indev (Prism 0.3)' --yesno 'Welcome to Synterra Indev (Prism 0.3).\n\nSynterra Surf is your new browser, pinned to the taskbar. Take screenshots with Spectacle and open images in Gwenview. Aurora and Graphite are available in Desktop and Wallpaper settings.\n\nThe guided installer applies this desktop to your installed system. Connect to the internet first. At the final Archinstall screen choose EXIT so Synterra can finish.\n\nStart the installer now?' --yes-label 'Install Synterra' --no-label 'Explore desktop'; then
    exec synterra-install
fi
